;; 起動時に読み込まれるエントリスクリプト。
;; Scheme は ECS を直接触らず、コマンドをキューに積むだけ。
;; 座標・時刻は整数でも小数でもよい。

;; 日課なしのNPC
(spawn-npc "ボブ" -150 -100)

;; 日課付きNPC: 各要素は (時 x y)。その時刻になったらその座標へ歩き出す。
(spawn-npc "アルバート" 0.0 0.0)
(set-schedule "アルバート"
              '((6 100 0)      ; 6時: 畑へ
                (12 0 100)     ; 12時: 食堂へ
                (18 0 0)))     ; 18時: 家へ
